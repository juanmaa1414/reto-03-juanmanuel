{
  "name": "agente-oc-sap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agente conversacional para la creación de órdenes de compra en SAP (reto técnico 03)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && npm --prefix web run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx demo.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.141",
    "@hono/node-server": "^1.19.0",
    "ai": "^5.0.287",
    "hono": "^4.9.0",
    "openai": "^6.8.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
